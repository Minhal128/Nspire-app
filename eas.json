{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "gradleCommand": ":app:assemblePlayRelease"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "gradleCommand": ":app:bundlePlayRelease"
      }
    },
    "amazon": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "gradleCommand": ":app:bundleAmazonRelease"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
