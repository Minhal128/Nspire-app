{
  "expo": {
    "name": "Inspire",
    "slug": "inspire-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/09cadeaf-d356-4a0a-b962-83166e56327a"
    },
    "splash": {
      "image": "./logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7DD3FC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inspire.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera for document scanning and property inspection.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save and upload inspection photos.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to tag property inspections."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#7DD3FC"
      },
      "package": "com.inspire.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "gradleProperties": {
        "kotlin.version": "2.0.21"
      }
    },
    "web": {
      "favicon": "./logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "09cadeaf-d356-4a0a-b962-83166e56327a"
      }
    }
  }
}
