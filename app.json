{
  "expo": {
    "name": "Inspire",
    "owner": "minhal786",
    "slug": "inspire-app",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./public/logo.png",
    "splash": {
      "image": "./public/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#97F0FF"
    },
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.0",
    "scheme": "inspire",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minhal.inspire",
      "requiresFullScreen": false,
      "associatedDomains": [
        "applinks:inspire.app",
        "applinks:*.inspire.app",
        "applinks:light-mutt-72.clerk.accounts.dev"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera for document scanning and property inspection.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save and upload inspection photos.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to tag property inspections."
      }
    },
    "android": {
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./public/logo.png",
        "backgroundColor": "#97F0FF"
      },
      "package": "com.minhal.inspire",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "inspire.app",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "*.inspire.app",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "light-mutt-72.clerk.accounts.dev"
            },
            {
              "scheme": "inspire"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./public/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.1.20"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b6da6ad6-b8b1-44a0-904d-6291c05042c7"
      }
    }
  }
}
